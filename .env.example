GPU_DISPATCHER_TOKEN=replace-with-a-long-random-token
GPU_DISPATCHER_DATA_DIR=/srv/data/gpu-task-dispatcher
OLLAMA_URL=http://127.0.0.1:11434
WHISPER_URL=http://127.0.0.1:8000
GPU_WORKERS_JSON=[{"id":"gpu-1","label":"Primary GPU","ollama_url":"http://127.0.0.1:11434","whisper_url":"http://127.0.0.1:8000"},{"id":"gpu-2","label":"Secondary GPU","ollama_url":"http://127.0.0.1:11436","whisper_url":"http://127.0.0.1:8001"}]
OLLAMA_URLS=http://127.0.0.1:11434,http://127.0.0.1:11436
GPU_SLOT_1_DEVICE=GPU-replace-with-primary-uuid
GPU_SLOT_2_DEVICE=GPU-replace-with-secondary-uuid
WHISPER_ENV_FILE=/opt/whisper-service/.env
GPU_MAX_BATCH_TASKS=12
GPU_MAX_BATCH_SECONDS=300
GPU_REQUEST_TIMEOUT_SECONDS=10800
GPU_OLLAMA_RELEASE_DELAY_SECONDS=4
GPU_JOB_HISTORY_LIMIT=100000
GPU_JOB_PAYLOAD_MAX_BYTES=524288
GPU_TASK_IDLE_SECONDS=10
