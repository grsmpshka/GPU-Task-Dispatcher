[Unit]
Description=GPU Task Dispatcher Monitor
After=network.target docker.service gpu-task-dispatcher.service
Wants=docker.service

[Service]
Type=simple
WorkingDirectory=/srv/apps/gpu-task-dispatcher/monitor
Environment=GPU_DISPATCHER_URL=http://127.0.0.1:11435
Environment=OLLAMA_URL=http://127.0.0.1:11434
Environment=DISK_PATHS=/,/srv
ExecStart=/srv/apps/gpu-task-dispatcher/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 9999
Restart=on-failure
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target

